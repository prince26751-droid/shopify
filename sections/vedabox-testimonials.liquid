<section class="testimonials-section">
  <div class="section-label">{{ section.settings.section_label }}</div>
  <h2>{{ section.settings.title }}</h2>
  <p class="section-sub">{{ section.settings.subtitle }}</p>
  <div class="testimonials-grid">
    {% for block in section.blocks %}
      {% if block.type == 'testimonial' %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-stars">
            {% assign star_count = block.settings.stars %}
            {% for i in (1..star_count) %}⭐{% endfor %}
          </div>
          <p class="testimonial-text">{{ block.settings.text }}</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">{{ block.settings.initials }}</div>
            <div>
              <strong>{{ block.settings.name }}</strong>
              <span class="testimonial-location">{{ block.settings.location }}</span>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section Label",
      "default": "Real Stories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Customers Are Saying"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "People aged 35 to 65, across India, who chose the natural path."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "This product has made a real difference in my blood sugar levels."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "City, State"
        },
        {
          "type": "text",
          "id": "initials",
          "label": "Initials (for avatar)",
          "default": "AB"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
