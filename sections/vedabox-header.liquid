<header>
  <div class="logo">{{ settings.brand_name_part1 }}<span>{{ settings.brand_name_part2 }}</span></div>
  <a href="{{ section.settings.cta_url }}" class="header-cta">{{ section.settings.cta_text }}</a>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Order Now →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL",
      "default": "#order"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
